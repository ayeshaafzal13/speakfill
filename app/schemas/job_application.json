{
 "id": "job_application",
 "title_en": "Job Application",
 "title_ur": "ملازمت کی درخواست",
 "fields": [
  {
   "id": "full_name",
   "label_en": "Full Name",
   "label_ur": "پورا نام",
   "type": "text",
   "required": true,
   "example": "Ali Raza",
   "validation": {
    "min_length": 3
   }
  },
  {
   "id": "father_name",
   "label_en": "Father's Name",
   "label_ur": "والد کا نام",
   "type": "text",
   "required": true,
   "example": "Muhammad Aslam"
  },
  {
   "id": "cnic",
   "label_en": "CNIC Number",
   "label_ur": "شناختی کارڈ نمبر",
   "type": "cnic",
   "required": true,
   "example": "35202-1234567-1"
  },
  {
   "id": "dob",
   "label_en": "Date of Birth",
   "label_ur": "تاریخ پیدائش",
   "type": "date",
   "required": true,
   "example": "15-03-2001",
   "validation": {
    "past": true
   }
  },
  {
   "id": "phone",
   "label_en": "Mobile Number",
   "label_ur": "موبائل نمبر",
   "type": "phone",
   "required": true,
   "example": "0300-1234567"
  },
  {
   "id": "email",
   "label_en": "Email",
   "label_ur": "ای میل",
   "type": "email",
   "required": false,
   "example": "ali@example.com"
  },
  {
   "id": "city",
   "label_en": "City",
   "label_ur": "شہر",
   "type": "text",
   "required": true,
   "example": "Lahore"
  },
  {
   "id": "address",
   "label_en": "Postal Address",
   "label_ur": "مکمل پتہ",
   "type": "address",
   "required": true,
   "example": "House 12, Street 4, Model Town"
  },
  {
   "id": "position",
   "label_en": "Position Applied For",
   "label_ur": "درخواست کردہ عہدہ",
   "type": "text",
   "required": true,
   "example": "Data Entry Operator"
  },
  {
   "id": "qualification",
   "label_en": "Highest Qualification",
   "label_ur": "اعلیٰ ترین تعلیم",
   "type": "select",
   "required": true,
   "options": [
    "Matric",
    "Intermediate",
    "Bachelor's",
    "Master's",
    "MPhil/PhD",
    "Other"
   ]
  },
  {
   "id": "institution",
   "label_en": "Institution",
   "label_ur": "تعلیمی ادارہ",
   "type": "text",
   "required": false,
   "example": "University of the Punjab"
  },
  {
   "id": "experience_years",
   "label_en": "Experience (years)",
   "label_ur": "تجربہ (سال)",
   "type": "number",
   "required": false,
   "example": "2",
   "validation": {
    "min": 0,
    "max": 60
   }
  },
  {
   "id": "skills",
   "label_en": "Skills",
   "label_ur": "مہارتیں",
   "type": "textarea",
   "required": false,
   "example": "MS Office, typing"
  }
 ]
}