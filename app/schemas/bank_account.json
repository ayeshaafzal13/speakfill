{
 "id": "bank_account",
 "title_en": "Bank Account Opening",
 "title_ur": "بینک اکاؤنٹ کھولنے کا فارم",
 "fields": [
  {
   "id": "full_name",
   "label_en": "Full Name",
   "label_ur": "پورا نام",
   "type": "text",
   "required": true,
   "example": "Ali Raza",
   "validation": {
    "min_length": 3
   }
  },
  {
   "id": "father_name",
   "label_en": "Father's Name",
   "label_ur": "والد کا نام",
   "type": "text",
   "required": true,
   "example": "Muhammad Aslam"
  },
  {
   "id": "mother_name",
   "label_en": "Mother's Name",
   "label_ur": "والدہ کا نام",
   "type": "text",
   "required": false,
   "example": "Fatima Bibi"
  },
  {
   "id": "cnic",
   "label_en": "CNIC Number",
   "label_ur": "شناختی کارڈ نمبر",
   "type": "cnic",
   "required": true,
   "example": "35202-1234567-1"
  },
  {
   "id": "dob",
   "label_en": "Date of Birth",
   "label_ur": "تاریخ پیدائش",
   "type": "date",
   "required": true,
   "example": "15-03-2001",
   "validation": {
    "past": true
   }
  },
  {
   "id": "phone",
   "label_en": "Mobile Number",
   "label_ur": "موبائل نمبر",
   "type": "phone",
   "required": true,
   "example": "0300-1234567"
  },
  {
   "id": "email",
   "label_en": "Email",
   "label_ur": "ای میل",
   "type": "email",
   "required": false,
   "example": "ali@example.com"
  },
  {
   "id": "occupation",
   "label_en": "Occupation",
   "label_ur": "پیشہ",
   "type": "text",
   "required": true,
   "example": "Teacher"
  },
  {
   "id": "monthly_income",
   "label_en": "Monthly Income (PKR)",
   "label_ur": "ماہانہ آمدن (روپے)",
   "type": "number",
   "required": false,
   "example": "50000",
   "validation": {
    "min": 0
   }
  },
  {
   "id": "address",
   "label_en": "Postal Address",
   "label_ur": "مکمل پتہ",
   "type": "address",
   "required": true,
   "example": "House 12, Street 4, Model Town"
  },
  {
   "id": "account_type",
   "label_en": "Account Type",
   "label_ur": "اکاؤنٹ کی قسم",
   "type": "select",
   "required": true,
   "options": [
    "Savings",
    "Current",
    "Digital"
   ]
  },
  {
   "id": "nominee_name",
   "label_en": "Nominee Name",
   "label_ur": "نامزد شخص کا نام",
   "type": "text",
   "required": true,
   "example": "Sara Raza"
  },
  {
   "id": "nominee_cnic",
   "label_en": "Nominee CNIC",
   "label_ur": "نامزد شخص کا شناختی کارڈ",
   "type": "cnic",
   "required": false,
   "example": "35202-7654321-2"
  }
 ]
}