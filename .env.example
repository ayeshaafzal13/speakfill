# Copy this file to .env and fill in your keys. NEVER commit .env to git.
GEMINI_API_KEY=
GROQ_API_KEY=

# Models (check the provider dashboards; names change over time)
GEMINI_MODEL=gemini-2.5-flash
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

# Budget guards (set slightly BELOW your provider's free-tier limits)
GEMINI_RPM=8
GROQ_RPM=20
MAX_LLM_CALLS_PER_SESSION=12
MAX_STT_CALLS_PER_SESSION=10

# Comma-separated list, only needed if the frontend is hosted on another domain
ALLOWED_ORIGINS=
